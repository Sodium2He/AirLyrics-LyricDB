      "right": "Artist ft. Guest"
    },
    {
      "id": "live-vs-stripped",
      "left": "Song (Live)",
      "right": "Song"
    },
    {
      "id": "punct-vs-plain",
      "left": "Hello, World",
      "right": "Hello World"
    }
  ],
  "same_secondary": [
